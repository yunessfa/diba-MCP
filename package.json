{
  "name": "iran-mcp",
  "version": "0.1.0",
  "description": "MCP server for Iranian services (Bale, Eitaa, Rubika, Soroush Plus) with a Persian dashboard",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "stdio": "tsx src/stdio.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:stdio": "node dist/stdio.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx test/e2e.ts",
    "netcheck": "tsx src/netcheck.ts"
  },
  "keywords": [
    "mcp",
    "iran",
    "bale",
    "eitaa",
    "rubika",
    "soroush"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "public"
  ],
  "engines": {
    "node": ">=22.19"
  }
}
