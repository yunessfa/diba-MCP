# cp .env.example .env

ADMIN_PASSWORD=change-me-please
# MCP_TOKEN=

PORT=3790
HOST=127.0.0.1
DATA_DIR=./data

# docker compose
BIND_ADDR=127.0.0.1
PUBLIC_PORT=3790
# DOMAIN=mcp.example.com
# TRUST_PROXY=1

# Proxy through a server inside Iran (see DEPLOY.md)
# SOCKS_PROXY=socks5://host.docker.internal:1080
# HTTPS_PROXY=http://user:pass@host:3128
# NO_PROXY=localhost,127.0.0.1

# Limits
# MCP_RATE_LIMIT=120
# MCP_WRITE_LIMIT=30
# LOG_RETENTION_DAYS=14
# UPSTREAM_TIMEOUT_MS=20000
# ALLOW_PRIVATE_MEDIA_URLS=false

# Messengers (optional, can also be set in the dashboard)
# BALE_ENABLED=true
# BALE_TOKEN=
# BALE_DEFAULT_CHAT_ID=
# BALE_RECEIVE=true

# EITAA_ENABLED=true
# EITAA_TOKEN=
# EITAA_DEFAULT_CHAT_ID=

# RUBIKA_ENABLED=true
# RUBIKA_TOKEN=
# RUBIKA_BASE_URL=https://botapi.rubika.ir/v3
# RUBIKA_RECEIVE=true

