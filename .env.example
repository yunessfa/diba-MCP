# این فایل را کپی کنید:  cp .env.example .env

# ---------- امنیت (حتماً عوض کنید) ----------
# رمز ورود به داشبورد. اگر خالی باشد، بار اول با «کد راه‌اندازی» از لاگ سرور ساخته می‌شود.
ADMIN_PASSWORD=change-me-please
# توکن اتصال کلاینت‌های MCP. خالی = خودکار ساخته و در داشبورد نمایش داده می‌شود.
# MCP_TOKEN=

# ---------- محدودیت‌ها (اختیاری) ----------
# MCP_RATE_LIMIT=120        # درخواست به /mcp در دقیقه برای هر IP
# MCP_WRITE_LIMIT=30        # ابزارهای ارسالی از طرف مدل در دقیقه
# LOG_RETENTION_DAYS=14
# UPSTREAM_TIMEOUT_MS=20000

# ---------- شبکه ----------
# اجرای بدون داکر:
PORT=3790
HOST=127.0.0.1
DATA_DIR=./data

# فقط برای docker compose:
#   127.0.0.1 = فقط از خود سرور (دسترسی با تونل SSH) — امن‌تر
#   0.0.0.0   = باز روی IP عمومی (فقط برای تست کوتاه)
BIND_ADDR=127.0.0.1
PUBLIC_PORT=3790

# با دامنه و HTTPS (docker compose --profile https up -d):
# DOMAIN=mcp.example.com
# TRUST_PROXY=1

# ---------- پراکسی به ایران (اگر سرور خارج از ایران به APIها نرسید) ----------
# تونل SSH به سرور ایران روی خود سرور آلمان (DEPLOY.md):
# SOCKS_PROXY=socks5://host.docker.internal:1080
# یا پراکسی HTTP:
# HTTPS_PROXY=http://user:pass@iran-server-ip:3128
# NO_PROXY=localhost,127.0.0.1,api.ipify.org

# ---------- پیام‌رسان‌ها (اختیاری؛ می‌شود از داشبورد هم تنظیم کرد) ----------
# مقدار env بر داشبورد اولویت دارد و آنجا قفل نمایش داده می‌شود.
# BALE_ENABLED=true
# BALE_TOKEN=
# BALE_DEFAULT_CHAT_ID=

# EITAA_ENABLED=true
# EITAA_TOKEN=
# EITAA_DEFAULT_CHAT_ID=

# RUBIKA_ENABLED=true
# RUBIKA_TOKEN=
# RUBIKA_BASE_URL=https://messengerg2b1.iranlms.ir/v3

# SOROUSH_ENABLED=true
# SOROUSH_TOKEN=
